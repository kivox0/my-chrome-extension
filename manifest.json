{
  "manifest_version": 3,
  "name": "Ближайшая аренда",
  "version": "1.0",
  "description": "Считает расстояние от объявлений об аренде на странице до нужного адреса и показывает самые близкие.",
  "permissions": ["activeTab", "scripting", "storage"],
  "host_permissions": ["https://nominatim.openstreetmap.org/*"],
  "background": { "service_worker": "background.js" },
  "action": { "default_popup": "popup.html", "default_title": "Ближайшая аренда" }
}
